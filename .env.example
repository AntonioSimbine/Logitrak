# =====================================================================
#  Logitrack — exemplo de variáveis de ambiente do backend
#  Copia este ficheiro para .env e preenche os valores.
#  NUNCA versiones o .env real.
# =====================================================================

# --- Base de dados MySQL 8 ---
DB_URL=jdbc:mysql://localhost:3306/logitrack?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Maputo&characterEncoding=UTF-8
DB_USERNAME=logitrack
DB_PASSWORD=

# --- Segurança ---
# Obrigatório: pelo menos 32 caracteres aleatórios.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720

# --- Servidor ---
PORT=8080

# --- CORS ---
# Em produção: https://o-teu-frontend.exemplo.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ficheiros e demonstração ---
LOGITRACK_UPLOAD_DIR=uploads
LOGITRACK_DEMO_SEED=true
# Obrigatório enquanto LOGITRACK_DEMO_SEED=true.
LOGITRACK_DEMO_PASSWORD=

# --- Agendador de SLA ---
SLA_INTERVALO_MS=60000
