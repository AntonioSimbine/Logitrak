<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Cabeçalho navy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_brand"
            android:gravity="center"
            android:text="@string/brand_mark"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/queue_screen_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/queue_screen_subtitle"
                android:textColor="@color/login_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSync"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_button_dark"
            android:contentDescription="@string/sync_button"
            android:padding="10dp"
            android:src="@drawable/ic_sync"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

        <!-- Pesquisa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/blue" />

            <EditText
                android:id="@+id/etBusca"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/history_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/navy"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnLimparBusca"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/blue" />

            <TextView
                android:id="@+id/tvResumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/queue_loading"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Separadores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_tab_container"
        android:elevation="1dp"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/tabTodos"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_all"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeTodos"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_on_blue"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabEnviados"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabEnviados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_sent"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeEnviados"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_soft"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="0"
                android:textColor="@color/blue_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPorEnviar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabPorEnviar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_to_send"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgePorEnviar"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_soft"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="0"
                android:textColor="@color/blue_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="26dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/emptyFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_empty"
                android:elevation="1dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="36dp"
                android:paddingEnd="22dp"
                android:paddingBottom="36dp">

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_icon_blue_soft">

                    <ImageView
                        android:id="@+id/ivEmptyFila"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_list"
                        app:tint="@color/blue" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEmptyTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="@string/history_empty_title"
                    android:textColor="@color/navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/history_empty_text"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp" />

                <ProgressBar
                    android:id="@+id/progressoFila"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/blue" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
