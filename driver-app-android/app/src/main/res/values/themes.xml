<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Transições entre ecrãs: entrada lateral curta e desvanecimento. -->
    <style name="Animation.Logitrack" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Theme.LogitrackMotorista" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/Animation.Logitrack</item>
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_soft</item>
        <item name="colorOnPrimaryContainer">@color/navy_2</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="colorTertiary">@color/green</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.LogitrackMotorista.Transparent" parent="Theme.LogitrackMotorista">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.LogitrackMotorista.Splash" parent="Theme.LogitrackMotorista">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Cartões / painéis -->
    <style name="Widget.Logitrack.Panel" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Logitrack.Panel.Small" parent="Widget.Logitrack.Panel">
        <item name="cardCornerRadius">14dp</item>
    </style>

    <!-- Botões -->
    <style name="Widget.Logitrack.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="Widget.Logitrack.Button.Gradient" parent="Widget.Logitrack.Button.Primary">
        <item name="backgroundTint">@color/blue</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Logitrack.Button.Navy" parent="Widget.Logitrack.Button.Primary">
        <item name="backgroundTint">@color/navy</item>
    </style>

    <style name="Widget.Logitrack.Button.Success" parent="Widget.Logitrack.Button.Primary">
        <item name="backgroundTint">@color/green</item>
    </style>

    <style name="Widget.Logitrack.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/blue</item>
        <item name="strokeColor">@color/blue_border</item>
        <item name="backgroundTint">@color/card</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Logitrack.Button.SoftBlue" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blue_soft</item>
        <item name="android:textColor">@color/blue_dark</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="Widget.Logitrack.IconButton" parent="">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/ink</item>
    </style>

    <style name="Widget.Logitrack.IconButton.Boxed" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_header_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/navy</item>
    </style>

    <!-- Campos de texto -->
    <style name="Widget.Logitrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/input_stroke_light</item>
        <item name="boxStrokeWidth">1.2dp</item>
        <item name="boxStrokeWidthFocused">1.8dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/blue</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Widget.Logitrack.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/input_stroke_light</item>
        <item name="boxStrokeWidth">1.2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/blue</item>
    </style>

    <style name="Widget.Logitrack.TextInputLayout.Login" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/login_glass</item>
        <item name="boxStrokeColor">@color/input_stroke_login</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/cyan</item>
        <item name="android:textColorHint">@color/login_muted</item>
        <item name="startIconTint">@color/login_muted</item>
        <item name="endIconTint">@color/login_muted</item>
    </style>

    <!-- Navegação inferior -->
    <style name="Widget.Logitrack.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/blue_soft</item>
    </style>

    <style name="TextAppearance.Logitrack.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Logitrack.NavLabelActive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Cabeçalhos e textos -->
    <style name="TextAppearance.Logitrack.HeaderTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Logitrack.HeaderTitle.Light" parent="TextAppearance.Logitrack.HeaderTitle">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Logitrack.HeaderSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/login_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Logitrack.SectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Logitrack.RowTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Logitrack.RowSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Logitrack.Pill" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Logitrack.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Logitrack.FieldLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Logitrack.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/blue</item>
    </style>
</resources>
