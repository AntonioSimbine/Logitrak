<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#E6F2FB"
                android:centerColor="#D5EBFC"
                android:endColor="#C2E2F9" />
        </shape>
    </item>
    <item android:top="96dp">
        <shape android:shape="rectangle">
            <solid android:color="#96C9EC" />
        </shape>
    </item>
    <item android:left="70dp" android:right="120dp" android:top="40dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#B7DBF5" />
        </shape>
    </item>
</layer-list>
