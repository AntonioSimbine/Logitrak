{
  "name": "logitrack-motorista",
  "version": "1.0.0",
  "description": "Logitrack - App nativa do motorista (offline-first)",
  "main": "index.js",
  "scripts": {
    "build:www": "node scripts/copy-m.js",
    "prebuild": "npm run build:www",
    "sync": "npx cap sync",
    "android": "npm run build:www && npx cap add android 2>nul || npx cap sync android && npx cap open android",
    "build:apk": "npm run build:www && npx cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/network": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "cordova-plugin-file": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "private": true
}
